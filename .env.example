# Template only: don't put real values in this file.
# Put real values in .env (ignored by Git) and in Vercel:
# Project > Settings > Environment Variables.

# --- Browser (safe to expose): Firebase console > Project settings > Your apps ---
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_APP_ID=
# ImageKit dashboard > Developer options, e.g. https://ik.imagekit.io/your_id
REACT_APP_IMAGEKIT_URL_ENDPOINT=

# --- Server only: never give these a REACT_APP_ prefix ---
# ImageKit dashboard > Developer options > API keys
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Firebase console > Project settings > Service accounts > Generate new private key,
# then base64-encode the downloaded JSON file.
FIREBASE_SERVICE_ACCOUNT=
SITE_URL=https://www.saboonexa.in
# Vercel: Project > Settings > Git > Deploy Hooks. Used by "Publish SEO changes".
VERCEL_DEPLOY_HOOK=
